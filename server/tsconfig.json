{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "jsx": "preserve"
  },
  "include": [
    "./**/*.ts",
    "../drizzle.config.ts",
    "../shared/**/*.ts"
  ],
  "exclude": [
    "../node_modules"
  ]
}
