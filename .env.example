# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Backend (server/) ---------------------------------------------------
# API connects as gs_app (no BYPASSRLS); migrations run as the table owner.
DATABASE_URL="postgres://gs_app:CHANGE_ME@localhost:5432/grantseeker"
MIGRATION_DATABASE_URL="postgres://grantseeker_owner:CHANGE_ME@localhost:5432/grantseeker"
DATABASE_SSL="disable" # disable | require | verify-full
DATABASE_POOL_MAX=20

# Generate with: npm run keys >> .env
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_KEY_ID="gs-ed25519-1"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed browser origins.
CORS_ORIGIN="http://localhost:3000"

# Express trust proxy: hop count or preset. Wrong values break rate limits and audit IPs.
TRUST_PROXY="loopback"
# Keep false until a mailer sends verification links.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Have I Been Pwned k-anonymity check on sign-up (fails open).
PASSWORD_BREACH_CHECK=true

# Gemini: AI match scoring and semantic search. Unset → local matcher + full-text search.
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# --- Harvester (npm run worker) -------------------------------------------
# Connects as gs_worker (writes grants, matches, notifications; reads only matching profile fields).
WORKER_DATABASE_URL="postgres://gs_worker:CHANGE_ME@localhost:5432/grantseeker"
SCRAPE_CRON="0 6,12 * * *"         # harvest schedule: daily at 06:00 and 12:00
HOUSEKEEPING_CRON="0 2 * * *"       # close expired calls, purge expired refresh tokens
CRON_TIMEZONE="Africa/Nairobi"
SCRAPE_ON_START=false               # run once at startup
HARVEST_DEFAULT_SOURCES=true        # built-in Grants.gov keyword searches
MATCH_NOTIFY_THRESHOLD=80           # notify on new matches scoring at least this

# --- Sign in with Google (optional) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised JavaScript origins: your site's origin (e.g. http://localhost:3000).
# No redirect URI is needed: the popup flow uses "postmessage".
# Leave both unset to hide Google sign-in. The secret stays on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (password reset links) ---
# Public address of the web app; reset links point here.
APP_URL="http://localhost:3000"
# SMTP connection, e.g. smtps://user:password@smtp.example.com:465
# Unset in development: emails are printed to the API log instead of sent.
# Unset in production: nothing is sent (an error is logged without the link).
SMTP_URL=
MAIL_FROM="GrantSeeker <no-reply@your-domain.example>"
